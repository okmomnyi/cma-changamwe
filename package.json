{
  "name": "cma-changamwe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node-pg-migrate -m migrations -j sql -d MIGRATION_DATABASE_URL --envPath .env up && npm run db:grants",
    "migrate:create": "node-pg-migrate -m migrations -j sql create",
    "db:grants": "tsx scripts/apply-grants.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "backup:run": "tsx scripts/run-backup.ts",
    "backup:verify": "tsx scripts/verify-backups.ts",
    "backup:restore": "tsx scripts/restore-backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@aws-sdk/s3-request-presigner": "^3.1113.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.11",
    "luxon": "^3.6.1",
    "node-pg-migrate": "^7.9.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
