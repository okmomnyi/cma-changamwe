NODE_ENV=development
PORT=3000
TZ=Africa/Nairobi

# Database
# The application connects as the least-privilege role, never the owner.
DATABASE_URL=postgres://cma_app:change-me@localhost:5432/cma_changamwe
MIGRATION_DATABASE_URL=postgres://cma_owner:change-me@localhost:5432/cma_changamwe
APP_DB_USER=cma_app
APP_DB_PASSWORD=change-me

# Auth
JWT_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SECURE_COOKIES=true

# HTTP
PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=true
LOG_LEVEL=info

# Serverless
SERVERLESS=false
CRON_SECRET=

# Email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=cma@stmaryschangamwe.org
BREVO_SENDER_NAME=CMA Changamwe
EMAIL_DAILY_BATCH_SIZE=200

# Cloudflare R2
# One bucket, two folders: pictures/ for member photographs, docs/ for exports.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PHOTOS_PREFIX=pictures
R2_BACKUPS_PREFIX=docs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_URL_TTL=300
R2_VIEW_URL_TTL=900

# Frontend
API_ORIGIN=http://127.0.0.1:3000
