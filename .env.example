# CMA Changamwe

NODE_ENV=development
PORT=3000
TZ=Africa/Nairobi

# Database: one Neon database, two roles.
#   DATABASE_URL           cma_app, least privilege. The server uses this.
#   MIGRATION_DATABASE_URL neondb_owner. Migrations, backups, restores.
# The audit log and score snapshots are protected by cma_app's grants, so the
# server must never connect as the owner.
DATABASE_URL=postgresql://cma_app:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
MIGRATION_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
APP_DB_USER=cma_app
# Blank: Neon rejects password changes from SQL. Set it in the Neon console.
APP_DB_PASSWORD=

# Auth
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SECURE_COOKIES=false
# Lets DEMO- accounts skip the emailed code. Never true in production.
ALLOW_DEMO_LOGIN=false

# HTTP
PUBLIC_BASE_URL=http://localhost:3000
API_ORIGIN=http://127.0.0.1:3000
TRUST_PROXY=false
LOG_LEVEL=info

# Jobs. SERVERLESS=false runs them from the in-process timer.
SERVERLESS=false
CRON_SECRET=

# Cloudflare R2. One bucket: docs/backups/ and pictures/.
R2_ACCOUNT_ID=
R2_BUCKET=cma-changamwe
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUPS_PREFIX=docs
R2_PHOTOS_PREFIX=pictures
R2_UPLOAD_URL_TTL=300
R2_VIEW_URL_TTL=900

# Backups. Older than RETENTION_DAYS is deleted only once MIN_KEEP verified
# newer ones exist, so a run of failures cannot erode the last good copies.
BACKUP_RETENTION_DAYS=7
BACKUP_MIN_KEEP=3

# Ed25519 key sealing every issued document. Generate: npm run documents:keygen
DOCUMENT_SIGNING_KEY=

# Email. Blank key logs the message instead of sending, development only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=cma@stmaryschangamwe.org
BREVO_SENDER_NAME=CMA Changamwe
EMAIL_DAILY_BATCH_SIZE=200
